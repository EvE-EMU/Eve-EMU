# Alliance Auth (aa-web) — set in Compose / local.py environment

# External consumers (recommended): consumer_id:secret pairs
ESI_FORWARDER_API_KEYS=emu-report:generate-a-long-random-string,internal:another-secret

# Legacy single secret (still supported)
# ESI_FORWARDER_INTERNAL_SECRET=generate-a-long-random-string

ESI_FORWARDER_DEFAULT_TOKEN_ID=58

# Optional: restrict to Great Damn EMU Report public IP
# ESI_FORWARDER_ALLOWED_IPS=203.0.113.50/32
# ESI_FORWARDER_REQUIRED_SCOPES=esi-wallet.read_corporation_wallets.v1
# ESI_FORWARDER_COMPATIBILITY_DATE=2025-12-16
# ESI_FORWARDER_USER_AGENT=MyCorp-ESI-Forwarder/1.0
