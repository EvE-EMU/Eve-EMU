# Test stack — copy to `.env.test` (do not commit `.env.test`).
# Used with: docker compose -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test
# Guide: docs/TEST_ENV.md

DOMAIN_NAME=test.eve-emu.com
PUBLIC_API_URL=https://test.eve-emu.com
CORE_PUBLIC_BASE_URL=https://test.eve-emu.com

POSTGRES_USER=eve
POSTGRES_PASSWORD=change-me-test
POSTGRES_DB_CORE=eve_emu_core
POSTGRES_DB_AA=eve_emu_aa
POSTGRES_DB_MARKET=eve_emu_market

REDIS_URL=redis://redis:6379/0

# Avoid clashing with production host port bindings.
POSTGRES_PUBLISH_PORT=15432
REDIS_PUBLISH_PORT=16379
CORE_API_PUBLISH_PORT=18000
CORE_WEB_PUBLISH_PORT=13000

# Separate Django secret from production.
AA_DJANGO_SECRET_KEY=
AA_SITE_URL=https://auth.test.eve-emu.com
AA_SITE_NAME=EVE-EMU Test Auth
AA_ALLOWED_HOSTS=auth.test.eve-emu.com,aa-web,localhost,127.0.0.1
AA_CSRF_TRUSTED_ORIGINS=https://auth.test.eve-emu.com
AA_SKIP_EMAIL_VERIFY=1
AA_DEBUG=0

# CCP app: add callback https://auth.test.eve-emu.com/sso/callback (and Discord callback if used).
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=
ESI_CALLBACK_URL=https://auth.test.eve-emu.com/sso/callback
CORE_SSO_CALLBACK_URL=https://test.eve-emu.com/v1/auth/eve/callback

WIKIJS_URL=https://wiki.test.eve-emu.com
WIKIJS_API_URL=http://wikijs:3000
WIKIJS_API_KEY=

# Reuse production Discord bot only if you intend to; otherwise leave blank.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

AA_EXTENSIONS_ENABLED=1
AA_ESI_COMPATIBILITY_DATE=2026-05-19
