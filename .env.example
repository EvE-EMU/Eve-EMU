# =============================================================================
# EvE-EMU — unified environment (root `.env`)
# Copy to `.env` and run `./setup.sh` (Git Bash / WSL / Linux). Do not commit `.env`.
# Operational checklist: docs/DOCKER.md
# =============================================================================

# -----------------------------------------------------------------------------
# [GLOBAL]
# -----------------------------------------------------------------------------
# Public site apex (no scheme) — Caddy serves https://<DOMAIN_NAME> via core-web.
# Alliance Auth is at https://auth.<DOMAIN_NAME> — configure **AA_SITE_URL** (see [AA_WEB]).
DOMAIN_NAME=eve-emu.com

# Browser-reachable FastAPI base (scheme + host[:port]). Used by Next.js build and docs.
# Example production: https://api.eve-emu.com  or  publish core-api on :8000 during dev
PUBLIC_API_URL=https://api.eve-emu.com

# Optional subpath for Next.js (build-time); leave empty for `/`.
# CORE_WEB_BASE_PATH=

# --- Local-only (Docker Desktop / no TLS): if you are not using the eve-emu.com URLs above,
# comment them out and use e.g. DOMAIN_NAME=localhost, AA_SITE_URL=http://127.0.0.1:8080,
# AA_ALLOWED_HOSTS=*, PUBLIC_API_URL=http://localhost:8000, CORE_PUBLIC_BASE_URL=http://localhost:8000,
# ESI_CALLBACK_URL=http://localhost:8000/v1/auth/eve/callback

# Redis for Celery + Django cache style workloads (compose default shown).
REDIS_URL=redis://redis:6379/0

# Optional: publish ports overrides (host:container)
# POSTGRES_PUBLISH_PORT=5432
# REDIS_PUBLISH_PORT=6379
# CORE_API_PUBLISH_PORT=8000
# CORE_WEB_PUBLISH_PORT=3000
# Caddy (Alliance Auth edge): host 80/443 → container 80/443
# CADDY_HTTP_PUBLISH_PORT=80
# CADDY_HTTPS_PUBLISH_PORT=443

# -----------------------------------------------------------------------------
# [DATABASE]
# -----------------------------------------------------------------------------
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
POSTGRES_DB_CORE=eve_emu_core
POSTGRES_DB_AA=eve_emu_aa

# -----------------------------------------------------------------------------
# [EVE_ESI]
# -----------------------------------------------------------------------------
# CCP developer application (Tranquility). **Single canonical SSO callback** → FastAPI core.
# Alliance Auth should reuse the same EVE app or a second app with callbacks you control;
# keep secrets out of AA DB — root `.env` only.
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=
# CCP developer app callback for **FastAPI core** (must match how browsers reach core).
# Example production: https://api.eve-emu.com/v1/auth/eve/callback
# Alliance Auth SSO — must match CCP callback exactly (no trailing slash):
ESI_CALLBACK_URL=https://auth.eve-emu.com/sso/callback
# FastAPI core-api SSO (different path; add to the same CCP app when using core):
CORE_SSO_CALLBACK_URL=http://localhost:8000/v1/auth/eve/callback
# CORE_SSO_CALLBACK_URL=https://api.eve-emu.com/v1/auth/eve/callback

# Space-separated scopes for linked characters (matches core defaults; extend as needed).
CORE_SSO_SCOPES=publicData esi-industry.read_character_mining.v1 esi-contracts.read_character_contracts.v1 esi-assets.read_assets.v1 esi-markets.structure_markets.v1

# -----------------------------------------------------------------------------
# [DISCORD_BOT]
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
EVE_TICKET_QUEUE_CHANNEL_ID=

# Shared secret: Discord bot `Authorization: Bearer` to core plugin routes (same value as below).
DISCORD_BOT_CORE_SECRET=

# Bot → core URL inside compose (override only if you rename the service).
BOT_CORE_API_URL=http://core-api:8000

# Optional: same vars as `discord-bot/bot/example.env` (slash sync, mining, moon CSV, HR, …)
# EVE_DISCORD_BOT_ACTIVITY=
# EVE_BOT_DISCORD_INVITE_URL=
# EVE_MINING_PING_CHANNEL_ID=
# EVE_MOON_TIMERS_CHANNEL_ID=

# -----------------------------------------------------------------------------
# [AA_WEB]  Alliance Auth (Django 5) + industry_suite — `aa-web` / `aa-worker` / `aa-beat`
# -----------------------------------------------------------------------------
# **Primary setting for AA:** public base URL of the auth site (no trailing slash). Used for
# links, CSRF, and SSO redirect `{AA_SITE_URL}/sso/callback`.
# **CCP developer portal:** Applications → your app → Callback URL must include exactly:
#   https://auth.eve-emu.com/sso/callback
# (No trailing slash. Remove old apex callbacks like https://eve-emu.com/sso/callback if you moved auth to auth.*.)
AA_SITE_URL=https://auth.eve-emu.com
AA_SITE_NAME=EVE-EMU Alliance Auth
# Dev convenience: skip email verification (set 0 in production).
AA_SKIP_EMAIL_VERIFY=1
# Maintainer email for CCP / ESI (required by AA checks; set a real address for production).
# AA_ESI_USER_CONTACT_EMAIL=

AA_DJANGO_SECRET_KEY=
# Comma-separated hostnames Django accepts (no scheme). Use * only for local debugging.
AA_ALLOWED_HOSTS=auth.eve-emu.com
# Optional extra CSRF origins (comma-separated, with scheme). Defaults include **AA_SITE_URL**.
AA_DEBUG=0

# Alliance Auth extensions (installed in aa-* Docker image; see docs/ALLIANCE_AUTH.md)
# AA_TASKMONITOR_ENABLED=1
# Run packagemonitorcli refresh on each aa-web boot (slow; use once after install, then leave off)
# AA_PACKAGE_MONITOR_REFRESH_ON_BOOT=0
# Community AA apps (see docs/ALLIANCE_AUTH.md)
# AA_EXTENSIONS_ENABLED=1
#
# ESI OpenAPI compatibility date (django-esi / OpenAPI clients). Wrong date → many failed calls.
#
# HTTP **420** (“error limit exceeded”): CCP blocks your app briefly after too many *failed* ESI
# requests. Cooldown clears automatically; fix root causes: expired/revoked tokens, missing scopes,
# bad compatibility date, or heavy concurrent sync after enabling many extensions — check
# `docker compose logs aa-worker` / `aa-beat`. Discord: ##3rd-party-dev-and-esi — https://www.eveonline.com/discord
# AA_ESI_COMPATIBILITY_DATE=2025-12-16
# AA_EXTENSIONS_GRAPHQL=0
#
# Alliance Auth built-in Discord service (Services → Discord) + optional `aa-discordbot` container.
# Same bot token as emu-bot is fine; OAuth app needs callback https://auth.<domain>/discord/callback/
# DISCORD_APP_ID=
# DISCORD_APP_SECRET=
# DISCORD_CALLBACK_URL=https://auth.eve-emu.com/discord/callback/
# DISCORD_SYNC_NAMES=0
# AA_INSTALL_AADISCORDBOT=1
# DISCORDPROXY_HOST=discordproxy
# DISCORDPROXY_PORT=50051
# Wiki.js (Compose service `wikijs` + Caddy `wiki.<DOMAIN_NAME>` — see docs/WIKIJS.md)
# After Wiki.js setup wizard: Administration → API → Full Access key → paste below.
WIKIJS_URL=https://wiki.eve-emu.com
WIKIJS_API_URL=http://wikijs:3000
WIKIJS_API_KEY=
# POSTGRES_DB_WIKI=wikijs
# WIKIJS_PUBLISH_PORT=3080

# Wanderer CE — EVE mapper at https://wh.<DOMAIN_NAME> (see docs/WANDERER.md)
WANDERER_URL=https://wh.eve-emu.com
# SECRET_KEY_BASE: session signing, at least 64 characters — openssl rand -base64 64
WANDERER_SECRET_KEY_BASE=
# CLOAK_KEY: encrypts EVE tokens (AES-256-GCM), must decode to 32 bytes — openssl rand -base64 32
WANDERER_CLOAK_KEY=
# CCP app callback: https://wh.eve-emu.com/auth/eve/callback (separate from AA/core SSO).
# Scopes on the app: esi-location.read_location.v1, read_ship_type, read_online, esi-ui.write_waypoint.v1
# (NOT esi-search.search_structures.v1 — removed by CCP; see docs/WANDERER.md)
WANDERER_EVE_CLIENT_ID=
WANDERER_EVE_CLIENT_SECRET=
# POSTGRES_DB_WANDERER=wanderer
# AA_USE_MODELTRANSLATION=1
# AA_MARKETMANAGER_CELERY=0
# AA_MOONMINING_CELERY=1
# Celery beat intervals (defaults tuned to reduce ESI 420 / retry storms on small workers)
# AA_BEAT_SOVTIMER_SECONDS=300
# AA_BEAT_KILLSTATS_MINUTES=5
# AA_BEAT_AFAT_MINUTES=5
# AA_BEAT_TOP_MINUTES=15
# AA_BEAT_KILLTRACKER_SECONDS=300
# AA_BEAT_ESISTATUS_SECONDS=300
# AA_BEAT_MOONMINING_MINUTES=30
# CorpTools + Secure Groups (auto-assign groups by corp + Director role/title — see docs/SECURE_GROUPS_BY_TITLE.md)
# AA_CORPTOOLS_LOGIN_SCOPES=esi-characters.read_titles.v1 esi-characters.read_corporation_roles.v1

# Standing Fleet Tracker (Alliance Auth plugin at /standing-fleet/)
# SFT_CELERY=1
# SFT_POLL_INTERVAL_SECONDS=300
# SFT_MAX_CHARACTERS_PER_POLL=40
# SFT_ALLIANCE_ID=99010468
# SFT_STANDING_MOTD_SUBSTRINGS=WOMP,Standing,STANDING
# SFT_KILL_BONUS_POINTS=5
# SFT_POINTS_PER_STANDING_HOUR=1
# SFT_PULSE_POINTS_PER_PULSE=0.25
# SFT_PENALTY_PER_SOV_ROAM_HOUR=1

# Buyback v2: Janice pricing (request API key via Janice Discord — see janice.e-351.com)
# BUYBACKPROGRAM_PRICE_METHOD=Janice
# BUYBACKPROGRAM_PRICE_JANICE_API_KEY=

# Corp stock orders (auth.eve-emu.com/corp-orders/) — see docs/CORP_ORDERS.md
# CORP_ORDERS_GRANT_GROUPS=Directors,Officers
# CORP_ORDERS_CLAIM_GROUPS=Members,Directors,Officers
CORP_ORDERS_NEW_CONTRACT_WEBHOOK=https://discord.com/api/webhooks/1506291849722073130/QnaiLTEL-IvKfY8zQXEiRo9J-mo8JfnU2U2qrkWw6ax2LpoKguZyGxgUaSr4dOiNNDou
CORP_ORDERS_PAYBACK_WEBHOOK=https://discord.com/api/webhooks/1506291849722073130/QnaiLTEL-IvKfY8zQXEiRo9J-mo8JfnU2U2qrkWw6ax2LpoKguZyGxgUaSr4dOiNNDou
# CORP_ORDERS_PUSHX_CLIENT=eve-emu
# CORP_ORDERS_DEFAULT_DESTINATION_SYSTEM=3-F

# Core (FastAPI) — encryption for EVE refresh tokens in Postgres (generate if empty; `./setup.sh` fills).
CORE_TOKEN_ENCRYPTION_KEY=

# Public URL FastAPI uses in redirects / links (match how users reach the API in production).
CORE_PUBLIC_BASE_URL=https://api.eve-emu.com

# Discord ↔ core rank sync + moon taxes (same IDs/secrets as in core/.env.example).
CORE_FALSE_GODS_CORPORATION_ID=0
CORE_FG_RANK_ROLES_JSON=[]
CORE_MOON_TAX_ASSIGNEE_ID=0
CORE_MOON_TAX_PAYMENT_INSTRUCTIONS=

# OpenAPI docs on/off (1/true to enable).
CORE_OPENAPI_DOCS_ENABLED=1

# Optional redirect after Discord-linked SSO in browser.
# CORE_DISCORD_LINK_SUCCESS_URL=

# -----------------------------------------------------------------------------
# [INDUSTRIAL_PREFS]
# -----------------------------------------------------------------------------
# Defaults surfaced to Django settings and to core moon-tax plugin via compose mapping.
# Prefer later moving live values to DB (AA Admin or a core-web management UI) — keep secrets here only.
# Directors can override these in the database later without touching this file; env values remain fallbacks.
MINING_TAX_RATE=0
LOGISTICS_COST_PER_M3=1200
BPC_DEPOSIT_REQUIRED=0

# Finance plugin defaults (optional).
# CORE_FINANCE_DEFAULT_REGION_ID=10000002
