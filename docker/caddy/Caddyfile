# SITE_HOST = public apex (e.g. eve-emu.com), from compose env DOMAIN_NAME.
# Alliance Auth: auth.<SITE_HOST> — YouTrack: pm.<SITE_HOST> (see docs/YOUTRACK.md).
# Caddy obtains certificates when DNS points here and ports 80/443 reach this host.

wiki.{$SITE_HOST} {
	reverse_proxy wikijs:3000
}

wh.{$SITE_HOST} {
	handle /intel/* {
		uri strip_prefix /intel
		reverse_proxy wh-intel:8020 {
			transport http {
				resolvers 127.0.0.11
			}
		}
	}
	handle {
		reverse_proxy wanderer:8000 {
			transport http {
				resolvers 127.0.0.11
			}
			lb_try_duration 90s
			lb_try_interval 500ms
		}
	}
}

pm.{$SITE_HOST} {
	reverse_proxy youtrack:8080 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			resolvers 127.0.0.11
		}
		lb_try_duration 90s
		lb_try_interval 500ms
	}
}

auth.{$SITE_HOST} {
	reverse_proxy {
		dynamic a {
			name aa-web
			port 8080
			refresh 3s
			resolvers 127.0.0.11
		}
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		lb_try_duration 90s
		lb_try_interval 500ms
		transport http {
			resolvers 127.0.0.11
		}
	}
}

# YouTrack Hub may cache http:// OIDC endpoints from discovery; POST + 308 redirect
# returns an empty body and breaks token exchange. Proxy plain HTTP directly to AA.
http://auth.{$SITE_HOST} {
	reverse_proxy {
		dynamic a {
			name aa-web
			port 8080
			refresh 3s
			resolvers 127.0.0.11
		}
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		lb_try_duration 90s
		lb_try_interval 500ms
		transport http {
			resolvers 127.0.0.11
		}
	}
}

{$SITE_HOST} {
	@aa_dashboard path /dashboard /dashboard/*
	handle @aa_dashboard {
		redir https://auth.{host}{uri} temporary
	}

	@market_api path /api/market/*
	handle @market_api {
		reverse_proxy market-api:8010 {
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	@market_pages path /margin_finder* /market_trends* /contract_price* /tradeVol_type* /price_compare* /pi_rank* /market-browser* /appraisal*
	handle @market_pages {
		reverse_proxy market-web:8088
	}

	@market_static path /static/*
	handle @market_static {
		reverse_proxy market-web:8088
	}

	handle {
		reverse_proxy core-web:3000
	}
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

# Optional test stack (eve-emu-test) — see docs/TEST_ENV.md
import /etc/caddy/Caddyfile.test-routes
