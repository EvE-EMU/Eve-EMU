# SITE_HOST = public apex (e.g. eve-emu.com), from compose env DOMAIN_NAME.
# Alliance Auth: auth.<SITE_HOST>.
# Caddy obtains certificates when DNS points here and ports 80/443 reach this host.
#
# Production upstreams use explicit prod-* DNS aliases on eve_emu_edge so they never
# collide with the isolated test stack (eve-emu-test), which also attaches to eve_emu_edge.

# Speed plan (2026-09-13): only wiki./auth. had `encode` — every other block,
# including the main {$SITE_HOST} one, served market-web's static JS/CSS and
# core-api's JSON completely uncompressed even when the client asked for
# gzip (measured: a 198KB app.js, a 130KB openapi.json, both plain). A
# Caddyfile *global options* block does NOT cascade directives like `encode`
# into site blocks below it — that was wrong in the original plan writeup —
# a named snippet imported per-block is the actual mechanism.
(compress) {
	encode gzip zstd
}

wiki.{$SITE_HOST} {
	# Apache mod_deflate + Content-Length behind Caddy causes truncated
	# upstream bodies ("unexpected EOF") → browser ERR_HTTP2_PROTOCOL_ERROR.
	# Ask Apache for uncompressed responses; Caddy encodes for the client.
	import compress
	reverse_proxy http://prod-mediawiki:80 {
		header_up Host {host}
		header_up Accept-Encoding identity
		transport http {
			resolvers 127.0.0.11
			versions 1.1
			keepalive 0
			read_timeout 5m
			write_timeout 5m
		}
	}
}

wh.{$SITE_HOST} {
	import compress
	handle /intel/* {
		uri strip_prefix /intel
		reverse_proxy http://prod-wh-intel:8020 {
			transport http {
				resolvers 127.0.0.11
			}
		}
	}
	handle {
		reverse_proxy http://prod-pelican:80 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				resolvers 127.0.0.11
			}
			lb_try_duration 90s
			lb_try_interval 500ms
		}
	}
}

# emums (Emu Manager Suite) decommissioned 2026-09-13 — confirmed abandoned.
# Containers stopped, not removed; data backed up to
# backups/auto/emums-decommission-2026-09-13/. Route now returns a plain
# 410 instead of proxying to a stopped backend (see docs/DEPLOY_ROLLBACK.md
# for how to bring a service back if ever needed).
emums.{$SITE_HOST} {
	respond "This service has been decommissioned." 410
}

