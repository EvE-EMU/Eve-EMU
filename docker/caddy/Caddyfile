# SITE_HOST = public apex (e.g. eve-emu.com), from compose env DOMAIN_NAME.
# Alliance Auth: auth.<SITE_HOST> (e.g. auth.eve-emu.com) — set AA_SITE_URL to match.
# Caddy obtains certificates when DNS points here and ports 80/443 reach this host.

wiki.{$SITE_HOST} {
	reverse_proxy wikijs:3000
}

wh.{$SITE_HOST} {
	reverse_proxy wanderer:8000 {
		transport http {
			resolvers 127.0.0.11
		}
		lb_try_duration 90s
		lb_try_interval 500ms
	}
}

auth.{$SITE_HOST} {
	reverse_proxy {
		dynamic a {
			name aa-web
			port 8080
			refresh 3s
			resolvers 127.0.0.11
		}
		lb_try_duration 90s
		lb_try_interval 500ms
		transport http {
			resolvers 127.0.0.11
		}
	}
}

{$SITE_HOST} {
	@market_api path /api/market/*
	handle @market_api {
		reverse_proxy market-api:8010 {
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	@market_pages path /margin_finder* /market_trends* /contract_price* /tradeVol_type* /price_compare* /pi_rank* /market-browser* /appraisal*
	handle @market_pages {
		reverse_proxy market-web:8088
	}

	@market_static path /static/*
	handle @market_static {
		reverse_proxy market-web:8088
	}

	handle {
		reverse_proxy core-web:3000
	}
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}
