# YouTrack / TLS keystores (generate with deploy/youtrack/keystore/generate-keystore.*)
deploy/youtrack/keystore/*.p12
deploy/youtrack/keystore/*.jks

# =============================================================================
# Secrets — never commit real tokens (Discord will reset if leaked on GitHub)
# =============================================================================
# Ignore any file literally named ".env" anywhere in the repo (was: only
# "bot/.env", which did NOT match discord-bot/bot/.env — that caused leaks).
.env
.env.*
!.env.example
!.env.*.example

# Common local overrides (Next.js, tools)
.env.local
.env.*.local

# Python / local (legacy path if you still keep a bot at repo root /bot)
bot/.env

# =============================================================================
# Scratch / investigation dirs (extracted third-party wheels, etc. — the
# established `.tmp_<name>` convention for "download this package to read its
# source", never meant to be committed; 2,623 files of exactly this got
# committed anyway across 16 `.tmp_*` dirs before this rule existed)
# =============================================================================
.tmp_*/

# =============================================================================
# Python bytecode / virtualenvs
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
.venv_aa_test/
venv/
aa_gen_test/
ENV/
env/

# =============================================================================
# Local databases & media (Django / FastAPI dev)
# =============================================================================
*.sqlite3
*.db
db.sqlite3
local.sqlite
/media/
**/media/
staticfiles/

# =============================================================================
# Tooling / build output
# =============================================================================
# Node (eve-emu core-web)
core-web/node_modules/
core-web/.next/
core-web/out/

# Python packaging / tests
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# OS / editor
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Fleet tracker / app local data (if generated)
fleet-tracker/**/*.log
